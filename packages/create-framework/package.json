{
  "name": "@erikt/create-framework",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikthq/framework.git",
    "directory": "packages/create-framework"
  },
  "homepage": "https://github.com/erikthq/framework#readme",
  "bugs": "https://github.com/erikthq/framework/issues",
  "publishConfig": {
    "access": "public",
    "bin": {
      "create-framework": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "create-framework": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "template"
  ],
  "scripts": {
    "build": "pnpm dlx --package=typescript tsc -p tsconfig.build.json",
    "typecheck": "pnpm dlx --package=typescript tsc",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@erikt/framework-node": "workspace:*",
    "@types/node": "^26.4.0"
  }
}
