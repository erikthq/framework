{
  "$schema": "https://json.schemastore.org/tsconfig",
  // No "node" types here, and no @types/deno either — Deno publishes none this
  // repo can depend on, so serve.ts and store.ts declare the Deno globals they
  // use. "DOM" is the dependency-free source of the web types, exactly as in the
  // root config; its presence is not permission to use the rest of it.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
