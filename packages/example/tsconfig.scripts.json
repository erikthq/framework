{
  "$schema": "https://json.schemastore.org/tsconfig",
  // src/scripts holds browser code, not Node code: it is never imported, only
  // read as text, stripped of its types and served. So it is checked against
  // DOM rather than @types/node, and the main config excludes it. `exclude`
  // is safe here precisely because nothing imports these files.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/scripts/**/*.ts"]
}
